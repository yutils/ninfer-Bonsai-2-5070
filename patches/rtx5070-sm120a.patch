diff --git a/CMakeLists.txt b/CMakeLists.txt
index 427804a..5fdfd6b 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -20,6 +20,9 @@ project(ninfer LANGUAGES C CXX CUDA)
 option(NINFER_BUILD_APPS "Build the NInfer CLI and server" ON)
 option(BUILD_TESTING "Build NInfer tests" OFF)
 option(NINFER_BUILD_BENCHMARKS "Build NInfer benchmarks" OFF)
+# Windows builds have no system FFmpeg; set this to skip the media-decoding link entirely
+# (image/video input becomes unavailable, text-only inference is unaffected).
+option(NINFER_DISABLE_MEDIA "Build without FFmpeg media decoding" OFF)
 
 set(CMAKE_CXX_STANDARD 20)
 set(CMAKE_CXX_STANDARD_REQUIRED ON)
@@ -35,6 +38,11 @@ endif()
 if(CMAKE_CUDA_ARCHITECTURES MATCHES "89")
   add_compile_definitions(NINFER_SM89=1)
 endif()
+# sm_120a (Blackwell) builds keep the default high-shared-memory schedules and the
+# warp-specialized TMA kernels. device.h still needs a compile-time SM count.
+if(CMAKE_CUDA_ARCHITECTURES MATCHES "^120")
+  add_compile_definitions(NINFER_SM120=1)
+endif()
 
 if(MSVC)
   add_compile_definitions(NOMINMAX UTF8PROC_STATIC)
@@ -63,7 +71,7 @@ if(CMAKE_CUDA_COMPILER_VERSION VERSION_LESS 13.1)
 endif()
 
 set(NINFER_BUILD_MEDIA_ACQUIRE OFF)
-if(NINFER_BUILD_APPS OR BUILD_TESTING)
+if((NINFER_BUILD_APPS OR BUILD_TESTING) AND NOT NINFER_DISABLE_MEDIA)
   set(NINFER_BUILD_MEDIA_ACQUIRE ON)
 endif()
 
@@ -78,17 +86,19 @@ if(NINFER_BUILD_APPS OR BUILD_TESTING)
 endif()
 
 find_package(CUDAToolkit REQUIRED)
-if(MSVC)
-  add_library(PkgConfig::FFMPEG INTERFACE IMPORTED)
-  target_include_directories(PkgConfig::FFMPEG INTERFACE "${PROJECT_SOURCE_DIR}/ffmpeg/include")
-  target_link_directories(PkgConfig::FFMPEG INTERFACE "${PROJECT_SOURCE_DIR}/ffmpeg/lib")
-  target_link_libraries(PkgConfig::FFMPEG INTERFACE avcodec avformat avutil swscale swresample)
-else()
-  find_package(PkgConfig REQUIRED)
-  pkg_check_modules(FFMPEG REQUIRED IMPORTED_TARGET
-    libavformat>=60 libavcodec>=60 libavutil>=58 libswscale>=7)
-  if(NINFER_BUILD_MEDIA_ACQUIRE)
-    pkg_check_modules(LIBCURL REQUIRED IMPORTED_TARGET libcurl>=7.85)
+if(NOT NINFER_DISABLE_MEDIA)
+  if(MSVC)
+    add_library(PkgConfig::FFMPEG INTERFACE IMPORTED)
+    target_include_directories(PkgConfig::FFMPEG INTERFACE "${PROJECT_SOURCE_DIR}/ffmpeg/include")
+    target_link_directories(PkgConfig::FFMPEG INTERFACE "${PROJECT_SOURCE_DIR}/ffmpeg/lib")
+    target_link_libraries(PkgConfig::FFMPEG INTERFACE avcodec avformat avutil swscale swresample)
+  else()
+    find_package(PkgConfig REQUIRED)
+    pkg_check_modules(FFMPEG REQUIRED IMPORTED_TARGET
+      libavformat>=60 libavcodec>=60 libavutil>=58 libswscale>=7)
+    if(NINFER_BUILD_MEDIA_ACQUIRE)
+      pkg_check_modules(LIBCURL REQUIRED IMPORTED_TARGET libcurl>=7.85)
+    endif()
   endif()
 endif()
 find_package(Threads REQUIRED)
diff --git a/src/core/device.h b/src/core/device.h
index dc1efd4..7458e75 100644
--- a/src/core/device.h
+++ b/src/core/device.h
@@ -25,8 +25,10 @@ int device_sm_count();
 inline constexpr int kTargetSmCount = 128; // NVIDIA GeForce RTX 4090
 #elif defined(NINFER_SM86)
 inline constexpr int kTargetSmCount = 82; // NVIDIA GeForce RTX 3090
+#elif defined(NINFER_SM120)
+inline constexpr int kTargetSmCount = 48; // NVIDIA GeForce RTX 5070 (Blackwell)
 #else
-#error "NInfer requires NINFER_SM86 or NINFER_SM89"
+#error "NInfer requires NINFER_SM86, NINFER_SM89 or NINFER_SM120"
 #endif
 
 // Non-owning execution facts passed to Ops whose launch policy depends on physical device
diff --git a/src/media/decode/decode.cpp b/src/media/decode/decode.cpp
index a814b97..e5a9648 100644
--- a/src/media/decode/decode.cpp
+++ b/src/media/decode/decode.cpp
@@ -655,6 +655,13 @@ namespace ninfer::media::decode {
     Video decode_video(std::span<const std::uint8_t> bytes, const Policy& policy, double fps, int min_f, int max_f) {
         throw std::runtime_error("Compiled without FFMPEG support.");
     }
+    ImageInfo inspect_image(std::span<const std::uint8_t> bytes, const Policy& policy) {
+        throw std::runtime_error("Compiled without FFMPEG support.");
+    }
+    VideoInfo inspect_video(std::span<const std::uint8_t> bytes, const Policy& policy,
+                            double fps, int min_frames, int max_frames) {
+        throw std::runtime_error("Compiled without FFMPEG support.");
+    }
 }
 #endif
 
